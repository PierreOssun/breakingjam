  "query": "select m.entry_id, d.id, d.dancer_name, d.country, d.country2, d.instagram_handle\n         from entry_members m join dancers d on d.id = m.dancer_id\n         where m.entry_id = any($1)\n         order by lower(d.dancer_name), d.id",
