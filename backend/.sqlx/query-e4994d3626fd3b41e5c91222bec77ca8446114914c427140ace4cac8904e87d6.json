  "query": "select coalesce(d.dancer_name, en.team_name) as \"who!\", en.reached::text as \"reached!\", en.final_rank, en.video_url\n           from entries en\n           left join entry_members m on m.entry_id = en.id\n           left join dancers d on d.id = m.dancer_id\n           order by en.final_rank nulls last, 1",
