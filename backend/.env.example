# Copy to backend/.env — never commit the real file.
DATABASE_URL=postgres://breakingjam:breakingjam@localhost:5432/breakingjam
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
# Uploaded flyers: `just media` serves a local bucket here for writing and reading both.
MEDIA_STORE_URL=http://localhost:8788
MEDIA_PUBLIC_URL=http://localhost:8788
# Code emails (M27): `just media` prints them to its console.
MAIL_URL=http://localhost:8788/mail
# Mixed into every password hash; any value in development (`openssl rand -base64 32` on a target).
PASSWORD_PEPPER=dev-pepper
RUST_LOG=breakingjam=debug,seed=info,tower_http=info
# Password for the admin and seed_admin users created by `cargo run --bin seed`.
SEED_PASSWORD=change-me
# LOG_FORMAT=json   # pretty logs unless set to json
