# Copy to deploy/.dev.vars for `npm run dev` (wrangler dev): the whole stack locally, with the
# API container built from backend/Dockerfile. Never commit the real file.
APP_BASE_URL=http://localhost:8787
GOOGLE_REDIRECT_URL=http://localhost:8787/api/auth/google/callback
API_INSTANCES=1
# The compose Postgres, seen from inside the container.
DATABASE_URL=postgres://breakingjam:breakingjam@host.docker.internal:5432/breakingjam
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
