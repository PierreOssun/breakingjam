# Response headers for the static site on Cloudflare (Workers static assets read this file).
# The CSP lists everything the app loads from elsewhere: Protomaps tiles and map fonts, the
# Nominatim address search, the YouTube player, uploaded flyers (both sites' media buckets).
# With self-hosted tiles (VITE_TILES_URL), add their host to connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://media.breakingjam.com https://media-uat.breakingjam.com; font-src 'self' data:; connect-src 'self' https://api.protomaps.com https://protomaps.github.io https://nominatim.openstreetmap.org; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

# Vite fingerprints everything under /assets: cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
